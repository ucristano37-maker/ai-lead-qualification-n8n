    {
      "parameters": {
        "jsCode": "const data = $json.body ?? $json;\nconst name=String(data.name??'').trim();\nconst email=String(data.email??'').trim().toLowerCase();\nconst company=String(data.company??'').trim();\nconst message=String(data.message??'').trim();\nconst budget=Number(data.budget??0);\nconst source=String(data.source??'Website').trim()||'Website';\nif(!name) throw new Error('Lead name is required');\nif(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) throw new Error('Valid email is required');\nif(!message) throw new Error('Lead message is required');\nif(!Number.isFinite(budget)||budget<0) throw new Error('Budget must be a valid non-negative number');\nreturn [{json:{name,email,company,message,budget,source,received_at:new Date().toISOString()}}];"
      },
