      "parameters": {
        "jsCode": "const lead=$('Validate Lead').first().json;\nconst rows=$input.all().map(i=>i.json).filter(r=>r&&typeof r==='object');\nconst duplicate=rows.some(r=>String(r.Email??r.email??'').trim().toLowerCase()===lead.email);\nreturn [{json:{...lead,duplicate}}];"
      },
