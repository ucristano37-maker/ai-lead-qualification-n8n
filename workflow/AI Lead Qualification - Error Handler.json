    {
      "parameters": {
        "jsCode": "const lead = $('Validate Lead').first().json;\nconst itemJson = $input.item.json;\n\n// Extract response text safely from n8n Gemini output format\nlet rawText = itemJson?.content?.parts?.[0]?.text \n           || itemJson?.message?.content \n           || itemJson?.text \n           || (typeof itemJson === 'string' ? itemJson : '');\n\nif (!rawText) throw new Error('AI response was empty');\n\n// Clean JSON code blocks, quotes, backslashes, and line breaks\nlet cleaned = String(rawText)\n  .trim()\n  .replace(/^```json\\s*/gi, '')\n  .replace(/^```\\s*/gi, '')\n  .replace(/\\s*```$/gi, '')\n  .replace(/\\\\\"/g, '\"')\n  .replace(/\\\\\\\\/g, '\\\\')\n  .replace(/[\\r\\n]+/g, ' ');\n\nlet a;\ntry {\n  a = JSON.parse(cleaned);\n} catch(e) {\n  throw new Error('Failed to parse AI response: ' + e.message);\n}\n\nreturn [{\n  json: {\n    ...lead,\n    ...a\n  }\n}];"
      },
